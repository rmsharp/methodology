#!/usr/bin/env python3
"""model-report -- read-only reporter surfacing which model(s) executed sessions
and actions in this repository. Full design: docs/planning/model-use-provenance-plan.md
section 4 (section 4.4 for this tool specifically), Phase 2 of section 8.

Reads THREE sources and keeps them visually and structurally separate in the
output -- NEVER merges them into one list or one number:

  1. PRIMARY / structured: `**Model:**` bullets in CHANGELOG.md -- self-reported,
     explicit, per-action (starter-kit/CHANGELOG.md's format section). Two
     dialects accepted (BL-20): the seed's `- **Model:**` list-item form, and
     this repo's own live bare `**Model:**` form (no leading `- `). A `### `
     entry header may carry one or more adjacent `[TAG]` groups (BL-33), e.g.
     `[BL-14][BL-17]` -- the source tag list has never said only one can
     appear. A `### `-prefixed line that still fails to match is never
     silently folded into the preceding entry; it is dropped and reported
     as a loud warning in Source 1's own output instead.
  2. SECONDARY / best-effort: free-text "model" mentions in the prose that
     follows each ```handoff block in HANDOFFS.md -- regex-fuzzy by nature
     (matches the bare word "model", so a mention in an unrelated sense will
     false-positive by design; this is a best-effort secondary source, not a
     structured field -- see starter-kit/HANDOFFS.md's "How to write a
     receipt" section).
  3. CORROBORATION-ONLY, explicitly non-authoritative: git `Co-Authored-By`
     trailers. A git trailer records who ran `git commit`, not which
     capability tier authored the content -- proven concretely by this fork's
     own S1 receipt (HANDOFFS.md): its `what_was_done` field states "Sonnet 5
     built P2/P4, Opus 4.8 did P3/P5/P6", yet ALL SIX of S1's real checkpoint
     commits -- including the two the receipt attributes to Sonnet -- carry
     the identical trailer "Claude Opus 4.8 (1M context)". This tool never
     presents trailer data merged with sources 1-2, and flags the one known
     non-model trailer pattern (a human co-author, rmsharp@me.com) rather
     than silently counting it as a model.

No pass/fail exit code -- a reporter, not a gate, matching bin/check-handoff's
honesty-ceiling framing ("verifies presence/structure, never truth") but going
one step further: this tool cannot even verify presence/structure of a TRUE
fact, only of a self-reported string. Read and display, never adjudicate --
feeds a retrospective (e.g. BL-8), never settles one.

THE POPULATION IS THE WHOLE LEDGER, NOT WHICHEVER SHARD IS LIVE TODAY. Sources
1 and 2 each read the live ledger PLUS every frozen shard the trimmer has cut
into docs/archive/, discovered by glob (see archive_shards). This is not a
refinement; without it the tool silently under-reports by however much has been
archived. Measured before the fix, against the tree at 2b71ec7: Source 1 saw 8
of 246 `**Model:**` bullets -- 96.7% of its own PRIMARY STRUCTURED source
invisible -- because a trim had moved 238 of them into ten shards, and
bin/tests.sh passed identically before and after that loss. Live and archived
records are ONE source spanning several files, never separate sources: the
trimmer refuses to write unless the move is provably lossless, so archiving
changes where a bullet sits, not how much it can be trusted.

Usage:
  bin/model-report                              # this fork's own root CHANGELOG.md /
                                                 # HANDOFFS.md PLUS their docs/archive/
                                                 # shards, falling back to starter-kit/
                                                 # + this repo's git history
  bin/model-report --changelog PATH --handoffs PATH --no-git   # explicit files (tests)
                                                 # -- an explicit path means EXACTLY that
                                                 # file and discovers no shards

Python 3 stdlib only; cross-platform. Canonical-only (like bin/check-handoff):
absent from bin/_manifest.py, adopters copy it manually if wanted.
"""
import argparse
import re
import subprocess
import sys
from collections import OrderedDict
from pathlib import Path

CHANGELOG_ENTRY_RE = re.compile(r"^### (\d{4}-\d{2}-\d{2}) · ((?:\[[^\]]+\])+) (.+)$")
CHANGELOG_HEADER_PREFIX_RE = re.compile(r"^### ")
CHANGELOG_MODEL_RE = re.compile(r"^-?\s*\*\*Model:\*\*\s*(.+)$")
CHANGELOG_SESSION_RE = re.compile(r"\*\*Session:\*\*\s*(\S+)")
CHANGELOG_FENCE_RE = re.compile(r"^```")
CHANGELOG_BULLET_RE = re.compile(r"^-\s")

# Where the trimmer freezes archived records. Owned by starter-kit/methodology_trim.py
# (`ARCHIVE_DIR`, :204); duplicated here as a literal rather than imported, because that
# module is 113 KB of trimming machinery and this is a read-only reporter -- see
# archive_shards() for the discovery rule and why it globs.
ARCHIVE_DIR = "docs/archive"

# Record-header date anchors, used ONLY to order files against each other (see
# newest_record_date). Anchored to the header, never a free scan of the file's prose.
CHANGELOG_DATE_RE = re.compile(r"^### (\d{4}-\d{2}-\d{2})", re.MULTILINE)
HANDOFF_DATE_RE = re.compile(r"^date:\s*(\d{4}-\d{2}-\d{2})", re.MULTILINE)

HANDOFF_OPEN_RE = re.compile(r"^```handoff[ \t]*$")
HANDOFF_SESSION_RE = re.compile(r"^session:\s*(\S+)")

# Secondary source: regex-fuzzy, best-effort by design (see module docstring).
FREE_TEXT_MODEL_RE = re.compile(r"\bmodel\b", re.IGNORECASE)

# The one known non-model Co-Authored-By value in this fork's own history (a
# human, not an agent) -- flagged rather than silently counted as a model (D3).
KNOWN_NON_MODEL_TRAILER_RE = re.compile(r"rmsharp@me\.com", re.IGNORECASE)
CO_AUTHORED_BY_RE = re.compile(r"^Co-Authored-By:\s*(.+)$", re.MULTILINE)

S1_DISCLAIMER = (
    "A git trailer records who ran `git commit`, not which capability tier authored\n"
    "the content. This fork's own S1 receipt (HANDOFFS.md) says \"Sonnet 5 built\n"
    "P2/P4, Opus 4.8 did P3/P5/P6\" -- yet ALL SIX of S1's real checkpoint commits,\n"
    "INCLUDING THE TWO THE RECEIPT ATTRIBUTES TO SONNET, carry the identical trailer\n"
    "\"Claude Opus 4.8 (1M context)\". Do not treat this section as ground truth for\n"
    "model/tier attribution -- it is corroboration-only, NEVER authoritative."
)


def repo_root() -> Path:
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, check=True,
        )
        return Path(out.stdout.strip())
    except (FileNotFoundError, subprocess.CalledProcessError):
        return Path.cwd()


def default_changelog(root: Path) -> Path:
    root_file = root / "CHANGELOG.md"
    return root_file if root_file.exists() else root / "starter-kit" / "CHANGELOG.md"


def default_handoffs(root: Path) -> Path:
    root_file = root / "HANDOFFS.md"
    return root_file if root_file.exists() else root / "starter-kit" / "HANDOFFS.md"


def archive_shards(root: Path, live: Path) -> list:
    """Every frozen archive shard of `live`, discovered by GLOB -- never by a
    hardcoded list of paths.

    This mirrors `starter-kit/methodology_trim.py`'s own `archive_events`
    (:909-930), which is the authority here: that tool WRITES the shards, owns
    `ARCHIVE_DIR = "docs/archive"` (:204), and mandates the flat
    `docs/archive/<BASENAME>-through-<CUTKEY>.md` shape (:1816-1821). Its
    docstring states the reason a glob and not a literal list: "bin/tests.sh
    wires exactly one shard by literal path in two places, so a second shard
    would never be checked and the suite would still pass". The same argument
    applies to a reporter: a literal list goes stale at the very next trim,
    silently, which is the defect this function exists to close.

    Matching `<STEM>-*.md` rather than `<STEM>-through-*.md` is deliberate and
    measured, not lax: it is what catches `HANDOFFS-archive.md`, a pre-`through`
    shard that a `-through-` pattern would silently drop. The trailing `.md`
    anchors the end of the name, so the `.verify.sh` proof siblings that share
    each shard's stem cannot be swept in.

    A missing `docs/archive/` is not an error and needs no guard -- `glob` over
    an absent directory yields nothing. That case is reported as a file count,
    never as silence: see `render`.
    """
    adir = root / ARCHIVE_DIR
    stem = live.name[:-3] if live.name.endswith(".md") else live.name
    return sorted(adir.glob("%s-*.md" % stem))


def newest_record_date(text: str, date_re) -> str:
    """The latest record date in `text`, or "" when it carries no dated record.

    ANCHORED to the record header (`^### YYYY-MM-DD` / `^date: YYYY-MM-DD`),
    never "the newest date appearing anywhere in the file". That distinction is
    load-bearing and was verified against this repo's real archives, not
    assumed: `docs/archive/CHANGELOG-through-v3.6.md` holds records dated
    2026-06-25..2026-07-26 -- it is the OLDEST shard -- but its front-matter
    PROSE mentions 2026-08-02, so an unanchored scan keys it as 2026-08-02 and
    files it eighth of ten instead of last. Anchored, all ten order correctly.
    """
    hits = date_re.findall(text)
    return max(hits) if hits else ""


def scan_ledger(live: Path, shards: list, parse_fn, date_re) -> list:
    """One scan record per file, live first, then shards newest-record first.

    A scan is {"path", "kind", "key", "items", "extra", "error"}. `items` is
    whatever parse_fn returns first (entries / hits); `extra` is its second
    return value when it has one (Source 1's unparsed headers), else [].

    `error` separates "could not read this" from "found nothing" -- the
    conflation this repo has fixed twice before (UAT F1; methodology_trim.py's
    classify_empty). An unreadable file keeps its row, carries the OS error,
    and is EXCLUDED from the population totals rather than contributing a
    silent zero; render() states the count of unreadable files beside the
    total, so a shrunken population can never be read as a real one.

    ORDERING. The live file is pinned first: it holds the newest records by
    definition of a trim. Shards follow, ordered by their own newest record
    date, descending, with undated files last and filename ascending as the
    tie-break (the trimmer emits `<stem>-through-<cutkey>-<N>.md` on a
    same-day collision, :1980-1982, so ties are reachable and must be stable).

    This orders FILES. It deliberately does NOT claim to produce one
    chronological stream of records, because on this repo's real archives the
    shard spans OVERLAP -- `CHANGELOG-through-2026-08-11.md` spans
    2026-08-02..08-11 and strictly contains `-2026-08-09.md`'s 08-03..08-09.
    Records keep their own file's internal order and are never merge-sorted
    across files; merging every file into one undifferentiated list is the
    shape this tool's docstring exists to refuse.
    """
    scans = []
    for path, kind in [(live, "live")] + [(s, "archived") for s in shards]:
        rec = {"path": path, "kind": kind, "key": "", "items": [], "extra": [],
               "error": None}
        try:
            text = path.read_text(encoding="utf-8", errors="replace")
        except OSError as exc:
            rec["error"] = str(exc)
            scans.append(rec)
            continue
        parsed = parse_fn(text)
        if isinstance(parsed, tuple):
            rec["items"], rec["extra"] = parsed[0], parsed[1]
        else:
            rec["items"] = parsed
        rec["key"] = newest_record_date(text, date_re)
        scans.append(rec)
    head, tail = scans[:1], scans[1:]
    # Two stable passes, because the two keys run in OPPOSITE directions: name
    # ascending as the tie-break, date descending as the primary. Sorting the
    # tie-break first and letting the stable primary sort preserve it is the
    # standard way to do that without encoding one direction as arithmetic on
    # the other. `key != ""` under reverse=True puts dated files above undated
    # ones (an undated or unreadable file sorts last), and ISO dates compare
    # correctly as plain strings.
    tail.sort(key=lambda r: r["path"].name)
    tail.sort(key=lambda r: (r["key"] != "", r["key"]), reverse=True)
    return head + tail


def parse_changelog_models(text: str) -> tuple:
    """Returns (entries, unparsed_headers).

    entries: one dict per ### entry that carries an optional **Model:**
    bullet. Entries without one are skipped entirely -- the field is
    optional, and a skipped entry must never be fabricated into the report.
    `source` holds the entry's full tag group exactly as written, brackets
    included (e.g. `[BL-20]` or `[BL-14][BL-17]`) -- one or more adjacent
    `[TAG]` groups (BL-33); the source tag list has never said only one can
    appear per entry.

    unparsed_headers: one (1-based line number, raw line text) pair for
    every line starting with `### ` that CHANGELOG_ENTRY_RE still fails to
    match. Such a line is NEVER silently folded into the preceding entry
    (BL-33's defect) -- it ends the current entry's bullet capture outright
    (`cur` resets to None) so nothing after it is misattributed, and it is
    surfaced in the report as a loud, counted warning instead.

    Fenced-code-block aware: starter-kit/CHANGELOG.md's own "How to add an
    entry" section permanently embeds fenced illustrative examples (dated
    ### headers, S42/S43 session IDs, <model> placeholders) as in-file
    documentation -- and that file is SEED-distributed verbatim to every new
    adopter's real root CHANGELOG.md. Any line inside a ``` ... ``` fence is
    skipped whole, so those illustrations are never parsed as real entries
    (and never counted as unparsed headers either).

    A **Model:** bullet's value may wrap onto indented continuation lines,
    matching this file's own wrapping convention for its other bullets
    (e.g. **Change:**, **Verified:**) -- continuation lines are joined with a
    single space.

    Two dialects, both accepted (BL-20): the seed's documented list-item form
    (`- **Model:** ...`) and this repo's own live convention, a bare
    `**Model:** ...` line with no leading `- `. CHANGELOG_MODEL_RE matches
    either; the leading `-` is optional, not required."""
    lines = text.splitlines()
    n = len(lines)
    entries = []
    unparsed_headers = []
    cur = None
    in_fence = False
    i = 0
    while i < n:
        line = lines[i]
        if CHANGELOG_FENCE_RE.match(line.strip()):
            in_fence = not in_fence
            i += 1
            continue
        if in_fence:
            i += 1
            continue
        m = CHANGELOG_ENTRY_RE.match(line)
        if m:
            cur = {
                "date": m.group(1), "source": m.group(2), "summary": m.group(3),
                "session": None, "model": None,
            }
            entries.append(cur)
            i += 1
            continue
        if CHANGELOG_HEADER_PREFIX_RE.match(line):
            unparsed_headers.append((i + 1, line))
            cur = None
            i += 1
            continue
        if cur is None:
            i += 1
            continue
        sm = CHANGELOG_SESSION_RE.search(line)
        if sm:
            cur["session"] = sm.group(1)
        mm = CHANGELOG_MODEL_RE.match(line.strip())
        if mm:
            value_parts = [mm.group(1).strip()]
            j = i + 1
            while j < n:
                nxt = lines[j]
                nxt_stripped = nxt.strip()
                if (not nxt_stripped or not nxt[:1].isspace()
                        or CHANGELOG_BULLET_RE.match(nxt_stripped)
                        or CHANGELOG_FENCE_RE.match(nxt_stripped)
                        or nxt_stripped.startswith("#")):
                    break
                value_parts.append(nxt_stripped)
                j += 1
            cur["model"] = " ".join(value_parts)
            i = j
            continue
        i += 1
    return [e for e in entries if e["model"]], unparsed_headers


def extract_handoff_prose(text: str) -> list:
    """Return a list of (session_id, prose_text) -- one per ```handoff block,
    where prose_text is the free-text following that block up to (not
    including) the next block. Fence-nesting aware exactly like
    bin/check-handoff's extract_blocks: a bare all-backtick wrapper line (the
    Format section's own illustrative example, wrapped in 4 backticks per
    CommonMark's fence-nesting rule) is skipped whole -- never mistaken for a
    real block, and never leaked into any session's prose."""
    lines = text.splitlines()
    n = len(lines)
    i = 0
    results = []
    current = None
    prose_buffer = []

    def flush():
        if current is not None:
            results.append((current, "\n".join(prose_buffer)))

    while i < n:
        stripped = lines[i].strip()
        if stripped and set(stripped) == {"`"} and len(stripped) >= 3:
            fence_len = len(stripped)
            i += 1
            while i < n:
                s2 = lines[i].strip()
                i += 1
                if set(s2) == {"`"} and len(s2) >= fence_len:
                    break
            continue
        if HANDOFF_OPEN_RE.match(lines[i]):
            flush()
            i += 1
            session = "?"
            while i < n:
                s2 = lines[i].strip()
                if set(s2) == {"`"} and len(s2) >= 3:
                    i += 1
                    break
                sm = HANDOFF_SESSION_RE.match(lines[i].strip())
                if sm:
                    session = sm.group(1)
                i += 1
            current = session
            prose_buffer = []
            continue
        if current is not None:
            prose_buffer.append(lines[i])
        i += 1
    flush()
    return results


def parse_handoffs_secondary(text: str) -> list:
    """One entry per (session, matched line) for every free-text line
    containing the bare word "model" in a session's post-block prose."""
    hits = []
    for session, prose in extract_handoff_prose(text):
        for line in prose.splitlines():
            if FREE_TEXT_MODEL_RE.search(line) and line.strip():
                hits.append((session, line.strip()))
    return hits


def git_trailers(no_git: bool, root: Path) -> list:
    if no_git:
        return []
    try:
        out = subprocess.run(
            ["git", "log", "--all", "--date=short", "--format=%H\x1f%ad\x1f%B\x1e"],
            capture_output=True, text=True, check=True, cwd=str(root),
        )
    except (FileNotFoundError, subprocess.CalledProcessError):
        return []
    trailers = []
    for record in out.stdout.split("\x1e"):
        record = record.strip("\n")
        if not record.strip():
            continue
        parts = record.split("\x1f", 2)
        if len(parts) < 3:
            continue
        sha, date, body = parts
        for m in CO_AUTHORED_BY_RE.finditer(body):
            value = m.group(1).strip()
            if not value:
                continue
            trailers.append({
                "sha": sha[:7], "date": date,
                "value": value,
                "non_model": bool(KNOWN_NON_MODEL_TRAILER_RE.search(value)),
            })
    return trailers


def plural(n, one, many) -> str:
    return one if n == 1 else many


def coverage_line(scans, unit) -> str:
    """The population sentence: how many `unit`, over how many files, and how
    many of those files could not be read.

    The unreadable count is never omitted and never folded into the total. A
    report that says "212 entries across 11 files" when one shard failed to
    open is the silent-population bug this whole change exists to close, wearing
    a different hat.
    """
    readable = [s for s in scans if s["error"] is None]
    unreadable = [s for s in scans if s["error"] is not None]
    total = sum(len(s["items"]) for s in readable)
    live_n = sum(len(s["items"]) for s in readable if s["kind"] == "live")
    text = ("(%d %s across %d %s: live %d + archived %d"
            % (total, unit, len(readable), plural(len(readable), "file", "files"),
               live_n, total - live_n))
    if unreadable:
        text += ("; %d %s UNREADABLE and excluded"
                 % (len(unreadable), plural(len(unreadable), "file", "files")))
    return text + ")"


def display_path(path: Path, root: Path) -> str:
    """Repo-relative where possible, so the report is comparable between
    machines and checkouts (an absolute /Users/... path is noise, and makes any
    test that reads these headers machine-specific)."""
    try:
        return path.resolve().relative_to(root.resolve()).as_posix()
    except (ValueError, OSError):
        return str(path)


def file_header(scan, root: Path, unit_note="") -> str:
    """Per-file provenance header.

    MUST NOT begin with a four-digit year: Test 31 counts Source-1 entries with
    `grep -c '^20[0-9][0-9]-'` over the whole output, so a header starting with a
    date would inflate that instrument. The leading `-- ` keeps it sound.
    """
    shown = display_path(scan["path"], root)
    if scan["error"] is not None:
        return "-- %s (%s) -- UNREADABLE: %s" % (shown, scan["kind"], scan["error"])
    n = len(scan["items"])
    return "-- %s (%s) -- %d %s" % (shown, scan["kind"], n, unit_note)


def render(source1_scans, source2_scans, trailers, root: Path) -> str:
    lines = []
    lines.append("model-report -- self-reported model/tier attribution, read-only, non-gating.")
    lines.append("See docs/planning/model-use-provenance-plan.md for the full design.")
    lines.append("")

    lines.append("=== SOURCE 1 -- PRIMARY (self-reported, structured): CHANGELOG.md **Model:** bullets ===")
    # Live and archived records are ONE source spanning several files, never two
    # sources. A trim is a storage move the trimmer refuses to make unless it is
    # provably lossless -- it changes where a `**Model:**` bullet sits, not how
    # reliable it is. Splitting them into separate sources would assert a
    # difference in KIND that does not exist, which is the same error the
    # docstring forbids, mirrored: a false split rather than a false merge.
    total1 = sum(len(s["items"]) for s in source1_scans if s["error"] is None)
    if total1:
        for scan in source1_scans:
            lines.append(file_header(scan, root, plural(len(scan["items"]), "entry carrying a **Model:** bullet", "entries carrying a **Model:** bullet")))
            for e in scan["items"]:
                session = e["session"] or "?"
                lines.append("%s  %-5s %s  %s" % (e["date"], session, e["source"], e["model"]))
                lines.append("    %s" % e["summary"])
        lines.append(coverage_line(source1_scans, "entries carry a **Model:** bullet"))
    else:
        # Sentinel preserved verbatim: bin/tests.sh Test 30 asserts this exact
        # string is ABSENT against the real ledger, so it stays load-bearing.
        lines.append("(no CHANGELOG.md entries carry a **Model:** bullet)")
    unparsed_total = sum(len(s["extra"]) for s in source1_scans)
    if unparsed_total:
        lines.append("")
        lines.append("WARNING: %d '### '-prefixed line(s) did NOT match "
                      "CHANGELOG_ENTRY_RE (BL-33) -- dropped, NOT folded into the "
                      "preceding entry:" % unparsed_total)
        for scan in source1_scans:
            for lineno, raw in scan["extra"]:
                lines.append("  %s:%d: %s" % (display_path(scan["path"], root), lineno, raw))
    lines.append("")

    lines.append('=== SOURCE 2 -- SECONDARY (self-reported, best-effort/regex-fuzzy): '
                  'HANDOFFS.md free-text "model" mentions ===')
    lines.append("(fuzzy match on the bare word \"model\" in each receipt's free-text prose;")
    lines.append(" false positives are expected by design -- NOT a structured field)")
    lines.append(" NOTE: receipts are NOT deduplicated across files. Measured on this repo,")
    lines.append(" 140 `session:` records span 133 distinct ids -- HANDOFFS-archive.md overlaps")
    lines.append(" the dated shards for S5/S7/S8/S9/S10/S11 (and S3 twice within one file), so a")
    lines.append(" session can legitimately appear under more than one file below. Collapsing")
    lines.append(" them would be adjudicating which copy is canonical; this tool reports.")
    total2 = sum(len(s["items"]) for s in source2_scans if s["error"] is None)
    if total2:
        for scan in source2_scans:
            lines.append(file_header(scan, root, plural(len(scan["items"]), "matched line", "matched lines")))
            for session, line in scan["items"]:
                lines.append("%-5s %s" % (session, line))
        lines.append(coverage_line(source2_scans, "matched line(s)"))
    else:
        lines.append("(no free-text \"model\" mentions found)")
    lines.append("")

    lines.append("=== SOURCE 3 -- CORROBORATION-ONLY, NEVER AUTHORITATIVE: "
                  "git Co-Authored-By trailers ===")
    for l in S1_DISCLAIMER.splitlines():
        lines.append(l)
    lines.append("")
    if trailers:
        by_value = OrderedDict()
        for t in trailers:
            by_value.setdefault(t["value"], []).append(t)
        total = len(trailers)
        lines.append("%d commits carry a Co-Authored-By trailer; %d distinct value(s):"
                      % (total, len(by_value)))
        for value, entries in by_value.items():
            flag = "  <-- FLAGGED: known non-model value (a human co-author)" \
                if entries[0]["non_model"] else ""
            newest = max(entries, key=lambda t: t["date"])
            lines.append("  %-45s  %4d commit(s)  most recent %s (%s)%s"
                          % (value, len(entries), newest["date"], newest["sha"], flag))
    else:
        lines.append("(no git trailer data -- --no-git or no Co-Authored-By trailers found)")

    return "\n".join(lines) + "\n"


def main() -> int:
    p = argparse.ArgumentParser(
        description="Report self-reported model/tier attribution across CHANGELOG.md, "
                     "HANDOFFS.md, and git trailers -- kept visually separate, never merged."
    )
    p.add_argument("--changelog", help="explicit CHANGELOG.md path (default: this repo's root, "
                                        "falling back to starter-kit/CHANGELOG.md)")
    p.add_argument("--handoffs", help="explicit HANDOFFS.md path (default: this repo's root, "
                                       "falling back to starter-kit/HANDOFFS.md)")
    p.add_argument("--no-git", action="store_true",
                    help="skip the git-trailer corroboration section entirely")
    args = p.parse_args()

    root = repo_root()
    changelog_path = Path(args.changelog) if args.changelog else default_changelog(root)
    handoffs_path = Path(args.handoffs) if args.handoffs else default_handoffs(root)

    if not changelog_path.exists():
        print("error: CHANGELOG.md not found: %s" % changelog_path)
        return 1
    if not handoffs_path.exists():
        print("error: HANDOFFS.md not found: %s" % handoffs_path)
        return 1

    # An EXPLICIT path means exactly that file and discovers nothing. Explicit
    # beats implicit; it is the pre-existing way to narrow the report; and it is
    # what lets Tests 23/30/31 -- which all pass explicit paths, two of them at
    # the real ledger -- keep asserting single-file populations unchanged.
    changelog_shards = [] if args.changelog else archive_shards(root, changelog_path)
    handoffs_shards = [] if args.handoffs else archive_shards(root, handoffs_path)

    source1_scans = scan_ledger(changelog_path, changelog_shards,
                                parse_changelog_models, CHANGELOG_DATE_RE)
    source2_scans = scan_ledger(handoffs_path, handoffs_shards,
                                parse_handoffs_secondary, HANDOFF_DATE_RE)
    trailers = git_trailers(args.no_git, root)

    print(render(source1_scans, source2_scans, trailers, root), end="")
    return 0


if __name__ == "__main__":
    sys.exit(main())

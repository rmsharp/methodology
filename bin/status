#!/usr/bin/env python3
"""Report drift of synced methodology files across one or more projects.

Emits one row per distributed file (Project · File · Disposition · Status) so the
full Option-B corpus is visible, not just a fixed three. The distribution set and
each file's disposition come from the shared bin/_manifest.py (B1 plan Decision 5);
status previously carried its own three-file copy of the list.

SEED files are adopter-owned: status reports present / absent for them and never flags
an absent seed as drift (B1 plan Phase 4 DONE criterion). A present seed that carries a
_manifest.SEED_FORMAT_MARKERS entry but whose content lacks the marker predates the
current seed format and is reported advisory-only as "present (stale format)" with a
migration note — never as drift, and sync never auto-overwrites it (BL-6 item 2).
TRACKED files are compared against canonical and may report current / locally modified /
N versions behind / missing.

Contract: methodology v2.2 plan §4E; B1 plan Phase 4.
"""
import argparse
import base64
import hashlib
import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _manifest import DISTRIBUTION, TRACKED, SEED_FORMAT_MARKERS  # noqa: E402  (bin/ on sys.path)

REPO = "KJ5HST/methodology"
HEADERS = ("Project", "File", "Disposition", "Status")


def script_methodology_root() -> Path:
    return Path(__file__).resolve().parent.parent


def blob_sha(content: bytes) -> str:
    header = f"blob {len(content)}\0".encode()
    return hashlib.sha1(header + content).hexdigest()


def detect_source(methodology_root: Path) -> str:
    return "local" if (methodology_root / "starter-kit").is_dir() else "github"


def local_canonical_sha(methodology_root: Path, src: str) -> str:
    content = (methodology_root / src).read_bytes()
    return blob_sha(content)


def history_walk(methodology_root: Path, src: str, walk_flag: str, blobs: dict) -> list:
    """List of (commit_sha, blob_sha) for the file along one walk, newest first.

    ``blobs`` caches commit -> blob across walks, since the two walks share commits."""
    try:
        log = subprocess.run(
            ["git", "-C", str(methodology_root), "log", walk_flag, "--format=%H", "--", src],
            capture_output=True, text=True, check=True,
        ).stdout.strip().splitlines()
    except (FileNotFoundError, subprocess.CalledProcessError):
        return []
    history = []
    for commit in log:
        if commit not in blobs:
            try:
                tree = subprocess.run(
                    ["git", "-C", str(methodology_root), "ls-tree", commit, "--", src],
                    capture_output=True, text=True, check=True,
                ).stdout.strip()
            except subprocess.CalledProcessError:
                continue
            # format: <mode> blob <sha>\t<path>
            parts = tree.split()
            blobs[commit] = parts[2] if len(parts) >= 3 and parts[1] == "blob" else None
        if blobs[commit]:
            history.append((commit, blobs[commit]))
    return history


def local_history(methodology_root: Path, src: str) -> dict:
    """The file's versions along two walks.

    "full" is every commit in the checkout's history (--full-history). Git's default walk
    follows only a merge's TREESAME parent, so a version on the side a merge did not keep was
    never visited and read as a local modification. "mainline" is the first-parent line: the
    versions that landed on the branch adopters sync from, one per merge however many commits
    the merged branch had. It is a subset of "full"."""
    blobs = {}
    return {
        "mainline": history_walk(methodology_root, src, "--first-parent", blobs),
        "full": history_walk(methodology_root, src, "--full-history", blobs),
    }


def versions_behind(walk: list, project_sha: str):
    """Distinct versions newer than the first commit carrying project_sha, or None if the walk
    never carries it. Distinct, because a merge that kept one side repeats that side's blob."""
    newer = set()
    for _, blob in walk:
        if blob == project_sha:
            return len(newer)
        newer.add(blob)
    return None


def github_canonical(src: str):
    try:
        result = subprocess.run(
            ["gh", "api", f"repos/{REPO}/contents/{src}"],
            capture_output=True, text=True, check=True,
        )
    except FileNotFoundError:
        sys.exit("error: gh CLI not found; install GitHub CLI or use --source=local")
    except subprocess.CalledProcessError as e:
        sys.exit(f"error: gh api failed for {src}: {e.stderr.strip() or e.stdout.strip()}")
    payload = json.loads(result.stdout)
    return payload["sha"], base64.b64decode(payload["content"])


def file_status(project: Path, dest: str, canonical_sha: str, history: dict) -> str:
    """Drift state of a TRACKED dest against canonical (and methodology history).

    N counts the main-line versions newer than the project's. A version that only ever existed
    on a merged branch has no main-line position, so it is counted along the full walk instead."""
    target = project / dest
    if not target.exists():
        return "missing"
    project_sha = blob_sha(target.read_bytes())
    if project_sha == canonical_sha:
        return "current"
    for walk in ("mainline", "full"):
        behind = versions_behind(history.get(walk, []), project_sha)
        if behind is not None:
            return f"{behind} versions behind" if behind != 1 else "1 version behind"
    return "locally modified"


STALE_SEED = "present (stale format)"


def seed_status(project: Path, dest: str) -> str:
    """SEED files are adopter-owned; only existence matters and an absent seed is
    NOT drift (B1 plan Phase 4 DONE criterion).

    A present seed that carries a known SEED_FORMAT_MARKERS entry but whose content
    lacks the marker predates the current seed format. That is reported advisory-only
    as STALE_SEED, never as drift and never acted on — sync leaves adopter-owned seeds
    untouched (BL-6 item 2)."""
    target = project / dest
    if not target.exists():
        return "absent"
    marker = SEED_FORMAT_MARKERS.get(dest)
    if marker:
        try:
            content = target.read_text(encoding="utf-8", errors="replace")
        except OSError:
            return "present"  # unreadable → don't guess the format
        if marker not in content:
            return STALE_SEED
    return "present"


def render_table(headers: tuple, rows: list) -> str:
    widths = [len(h) for h in headers]
    for row in rows:
        for i, cell in enumerate(row):
            widths[i] = max(widths[i], len(cell))
    def fmt(row):
        return "  ".join(str(cell).ljust(widths[i]) for i, cell in enumerate(row))
    return "\n".join([fmt(headers)] + [fmt(row) for row in rows])


def main() -> int:
    p = argparse.ArgumentParser(description="Report drift of methodology files across projects.")
    p.add_argument("paths", nargs="*", default=["."], help="Project directory (shell-expand globs)")
    p.add_argument("--source", choices=("local", "github"), help="local (default if sibling methodology/ exists) or github")
    args = p.parse_args()

    methodology_root = script_methodology_root()
    source = args.source or detect_source(methodology_root)
    if source == "local" and not (methodology_root / "starter-kit").is_dir():
        sys.exit(f"error: --source=local but no starter-kit/ at {methodology_root}")

    # Canonical SHA + history are only meaningful for TRACKED files; SEED files are
    # adopter-owned and never compared against canonical.
    canonical = {}
    history = {}
    for src, _dest, disp in DISTRIBUTION:
        if disp != TRACKED:
            continue
        if source == "local":
            canonical[src] = local_canonical_sha(methodology_root, src)
            history[src] = local_history(methodology_root, src)
        else:
            sha, _ = github_canonical(src)
            canonical[src] = sha
            history[src] = {}  # history-walk not implemented for github source

    rows = []
    for raw in args.paths:
        project = Path(raw).resolve()
        if not project.is_dir():
            rows.append((raw, "-", "-", "missing-dir"))
            continue
        for src, dest, disp in DISTRIBUTION:
            if disp == TRACKED:
                state = file_status(project, dest, canonical[src], history[src])
            else:  # SEED
                state = seed_status(project, dest)
            rows.append((project.name, dest, disp, state))

    print(f"source: {source}" + (f" ({methodology_root})" if source == "local" else ""))
    print(render_table(HEADERS, rows))

    stale_rows = [dest for _proj, dest, _disp, state in rows if state == STALE_SEED]
    if stale_rows:
        dests = sorted(set(stale_rows))  # count instances (one per project), list distinct files
        noun = "seed predates" if len(stale_rows) == 1 else "seeds predate"
        print(
            f"\nnote: {len(stale_rows)} {noun} the current format ({', '.join(dests)}, marked "
            f"'{STALE_SEED}'). These are adopter-owned and are never auto-overwritten. To migrate, "
            f"reconcile against the current starter-kit seed by hand, or delete the file and re-run "
            f"bin/sync to reseed (see BOOTSTRAP.md \"Updating an existing project from an earlier "
            f"methodology version\")."
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())

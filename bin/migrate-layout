#!/usr/bin/env python3
"""Move a project's methodology files under methodology/ (BL-101, phase P7).

CANONICAL-ONLY, like bin/sync and bin/status: it is not in bin/_manifest.py, so adopters do not receive it.
Contract: docs/planning/methodology-subdirectory-plan.md section 4.7 and section 7.3 row P7.

A project keeps its methodology files at its root and under docs/methodology/ (the legacy layout, the manifest's
`dest` column) or in one directory, methodology/ (the new layout, its NEW_LAYOUT table). This tool moves a
legacy project to the new layout. It is a dry run unless --apply is given: the dry run reads the project and
prints the plan, and writes nothing.

It REFUSES, before writing anything, a project that is not a git repository with a commit, one with a dirty tree,
a half-migrated one (a runner at the root and under methodology/), one where a destination already exists, one
that keeps its methodology files out of git (ignore mode), and one where bin/status does not read every TRACKED
file current: sync first (plan 5A.2), because a tool that cannot find the ledger fails open (plan C5). Every
refusal is reported together.

Tiers (plan 4.6): tier 1 moves the framework's own files (the manifest's TRACKED rows); tier 2 the project's state
(the SEED rows, the files the tools generate, the ledger shards the trimmer wrote). The default, all, is both.

Exit: 0 a dry run or a migration done, or nothing to do · 1 refused · 2 usage or a failure · 3 an apply that was
rolled back.
"""
import argparse
import difflib
import json
import os
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _manifest import DISTRIBUTION, TRACKED, SEED, NEW_LAYOUT  # noqa: E402  (bin/ on sys.path)

# A project keeps its methodology files at its root (legacy) or under methodology/ (new): the plan's
# section 4.3. This block is the resolver, embedded byte for byte; the canonical suite asserts that.

# --- layout resolver: BEGIN ---
import os as _os
from pathlib import Path as _Path


def resolve_layout(root, anchor="SESSION_RUNNER.md"):
    """Return (kind, directory, found): kind is new|legacy|half|none, directory a Path or None,
    found the anchor paths that exist. A half-migrated tree has no directory, by design.
    A file found in both places is the framework's under methodology/ when the runner is under
    methodology/ and not at the root: the root copy is the project's own and is left alone, kind new,
    and found still names both. Any other tie stays half, and the runner cannot decide a tie about itself."""
    root = _Path(root)
    new, old = root / "methodology" / anchor, root / anchor
    found = tuple(p for p in (new, old) if _os.path.isfile(p))
    if len(found) == 2:
        if _os.path.isfile(root / "methodology" / "SESSION_RUNNER.md") and not _os.path.isfile(root / "SESSION_RUNNER.md"):
            return "new", new.parent, found
        return "half", None, found
    if not found:
        return "none", None, ()
    return ("new", new.parent, found) if found[0] == new else ("legacy", root, found)
# --- layout resolver: END ---


NEW_DIR = "methodology"
# What the tools write beside the methodology files (plan section 2.1, "Generated beside them"). They are not in
# the manifest, so the table is here; tools/layout_fixtures.GENERATED is the test suite's copy of it.
GENERATED = ("dashboard.html", "dashboard_history.jsonl", ".context-budget-history.jsonl",  # layout: ok -- the files the tools generate; this tool moves them
             ".quality-gates-results.json")  # layout: ok -- same
ARCHIVE_OLD = "docs/archive"  # layout: ok -- where a trim has written shards so far; they move to methodology/archive
ARCHIVE_NEW = NEW_DIR + "/archive"
OLD_FRAMEWORK_DIR = "docs/methodology"  # layout: ok -- today's directory for the framework documents; the tool leaves what is not in the manifest
# A shard the trimmer wrote: <ledger>-through-<date>[-N].md and its proof beside it. Anything else in the archive
# directory is the project's own and stays.
SHARD_RE = re.compile(r"^(?:CHANGELOG|HANDOFFS|SESSION_NOTES)-through-[^/]+\.md(?:\.verify\.sh)?$")  # layout: ok -- the shard names the trimmer writes
GITATTRIBUTES = ".gitattributes"  # layout: ok -- the seed that moves, when it is only the seed's rules

HERE = Path(__file__).resolve().parent
CANONICAL = HERE.parent

REFUSAL_HELP = {
    "not-a-repository": "the project is not the top of a git repository",
    "no-commits": "the repository has no commit yet: there is no history for a move to keep",
    "dirty-tree": "the working tree is not clean",
    "half-migrated": "the runner is at the root and under methodology/",
    "destination-exists": "a file already sits where a move would land",
    "not-current": "bin/status does not read every TRACKED file current",
    "ignore-mode": "the project keeps its methodology files out of git",
    "tier-order": "tier 2 needs the framework files already under methodology/",
    "status-unavailable": "bin/status could not be run",
}


def run(project, *args, check=False):
    return subprocess.run(["git", "-C", str(project), *args], capture_output=True, text=True, check=check)


def canonical_info():
    r = subprocess.run(["git", "-C", str(CANONICAL), "rev-parse", "HEAD"], capture_output=True, text=True)
    sha = r.stdout.strip() if r.returncode == 0 else None
    dirty = bool(subprocess.run(["git", "-C", str(CANONICAL), "status", "--porcelain", "--untracked-files=no"],
                                capture_output=True, text=True).stdout.strip()) if sha else None
    return {"path": str(CANONICAL), "sha": sha, "modified": dirty}


def refusal(code, message, paths=()):
    return {"code": code, "message": message, "paths": list(paths)}


def tracked_files(project):
    r = run(project, "ls-files", "-z")
    return set(p for p in r.stdout.split("\0") if p)


def dirty_paths(project):
    """Every path `git status` reports, untracked files one by one: a dirty tree is any of them."""
    r = run(project, "status", "--porcelain=v1", "-z", "--untracked-files=all")
    out, entries = [], r.stdout.split("\0")
    i = 0
    while i < len(entries):
        entry = entries[i]
        i += 1
        if not entry:
            continue
        out.append(entry[3:])
        if entry[0] in "RC":
            i += 1  # a rename or copy carries its source as the next field
    return out


def is_ignore_mode(project):
    """bin/sync's rule: a .gitignore that lists a TRACKED destination, in either layout."""
    gi = Path(project) / ".gitignore"
    if not gi.is_file():
        return False
    lines = {line.strip() for line in gi.read_text(encoding="utf-8", errors="replace").splitlines()}
    entries = set()
    for src, dest, disp in DISTRIBUTION:
        if disp == TRACKED:
            entries.add("/" + dest)
            entries.add("/" + NEW_LAYOUT[src])
    return bool(entries & lines)


def read_status(project):
    """bin/status over the project, as rows (file, disposition, status). The columns are found from the header,
    where render_table left-justified every cell, so a project name or a status with a space does not shift them."""
    r = subprocess.run([sys.executable, "-B", str(HERE / "status"), str(project)], capture_output=True, text=True)
    if r.returncode != 0:
        return None, r.stderr.strip() or r.stdout.strip()
    lines = r.stdout.splitlines()
    head = next((i for i, line in enumerate(lines) if line.startswith("Project ")), None)
    if head is None:
        return None, "bin/status printed no table"
    h = lines[head]
    c1, c2, c3 = h.index("File"), h.index("Disposition"), h.index("Status")
    rows = []
    for line in lines[head + 1:]:
        if not line.strip():
            break
        rows.append((line[c1:c2].strip(), line[c2:c3].strip(), line[c3:].strip()))
    return rows, None


def seed_rules_only(text, seed_text):
    """True when every rule line of `text` is one of the seed's: the file holds nothing of the project's own."""
    def rules(t):
        return {line.strip() for line in t.splitlines() if line.strip() and not line.lstrip().startswith("#")}
    return rules(text) <= rules(seed_text)


def plan_moves(project, tier, tracked, kind):
    """(moves, left_in_place, collisions): what the tier moves from where the project keeps it to where the new
    layout puts it; what stays and why; and the destinations that already exist."""
    root = Path(project)
    moves, left, collisions = [], [], []

    def add(src, dest, what):
        moves.append({"src": src, "dest": dest, "kind": what, "tracked": src in tracked})

    for srcname, legacy, disp in DISTRIBUTION:
        in_tier = (disp == TRACKED and tier in ("1", "all")) or (disp == SEED and tier in ("2", "all"))
        if not in_tier:
            continue
        new = NEW_LAYOUT[srcname]
        old_here, new_here = (root / legacy).is_file(), (root / new).is_file()
        if old_here and new_here:
            if not (kind == "half" and legacy == "SESSION_RUNNER.md"):  # half-migrated is its own refusal
                collisions.append(new)
            continue
        if not old_here:
            continue  # absent, or already under methodology/
        if legacy == GITATTRIBUTES:
            seed_text = (CANONICAL / srcname).read_text(encoding="utf-8")
            if not seed_rules_only((root / legacy).read_text(encoding="utf-8", errors="replace"), seed_text):
                left.append({"path": legacy, "reason": "holds rules of the project's own; it stays at the root"})
                continue
        add(legacy, new, "manifest")
    if tier in ("2", "all"):
        for name in GENERATED:
            new = NEW_DIR + "/" + name
            old_here, new_here = (root / name).is_file(), (root / new).is_file()
            if old_here and new_here:
                collisions.append(new)
            elif old_here:
                add(name, new, "generated")
        for path in sorted(p for p in tracked if p.startswith(ARCHIVE_OLD + "/")):
            name = path[len(ARCHIVE_OLD) + 1:]
            if "/" not in name and SHARD_RE.match(name):
                new = ARCHIVE_NEW + "/" + name
                if (root / new).is_file():
                    collisions.append(new)
                else:
                    add(path, new, "shard")
    moved = {m["src"] for m in moves}
    for path in sorted(tracked):
        if path in moved:
            continue
        if path.startswith(OLD_FRAMEWORK_DIR + "/"):
            left.append({"path": path, "reason": "not a file of the manifest: the project's own, or an older copy; it stays"})
        elif path.startswith(ARCHIVE_OLD + "/") and tier in ("2", "all"):
            left.append({"path": path, "reason": "not a ledger shard the trimmer wrote: the project's own; it stays"})
    return moves, left, sorted(set(collisions))


class Rewrite:
    """A text file the migration edits: `path` where it is now, `final` where it will be once the moves are done."""

    def __init__(self, path, final, old, new, replacements):
        self.path, self.final, self.old, self.new, self.replacements = path, final, old, new, replacements

    def as_report(self):
        diff = "".join(difflib.unified_diff(self.old.splitlines(keepends=True), self.new.splitlines(keepends=True),
                                            fromfile=self.path, tofile=self.final))
        return {"path": self.path, "final": self.final, "replacements": self.replacements, "diff": diff}


def rewrite_gitignore(text, mapping):
    """An anchored ignore entry that is exactly a moved file's path follows it; an unanchored entry (no slash) still
    matches the file under methodology/ and is left alone, as is every comment. Returns (text, replacements)."""
    out, n = [], 0
    for line in text.splitlines(keepends=True):
        body = line.rstrip("\r\n")
        eol = line[len(body):]
        s = body.strip()
        neg = s.startswith("!")
        s = s[1:] if neg else s
        if s and not s.startswith("#"):
            path = s[1:] if s.startswith("/") else s
            if (s.startswith("/") or "/" in path.rstrip("/")) and path in mapping:
                out.append(("!" if neg else "") + "/" + mapping[path] + eol)
                n += 1
                continue
        out.append(line)
    return "".join(out), n


def plan_rewrites(root, moves):
    """The edits that go with the moves: the .gitignore entries that name a moved file."""
    mapping = {m["src"]: m["dest"] for m in moves}
    rewrites = []
    gi = Path(root) / ".gitignore"
    if gi.is_file():
        old = gi.read_text(encoding="utf-8")
        new, n = rewrite_gitignore(old, mapping)
        if n:
            rewrites.append(Rewrite(".gitignore", ".gitignore", old, new, n))
    return rewrites


def build_report(project, tier, apply_mode):
    root = Path(project)
    report = {"project": str(root), "canonical": canonical_info(), "layout": None, "tier": tier,
              "mode": "apply" if apply_mode else "dry-run", "status": "ok", "refusals": [], "moves": [],
              "left_in_place": [], "rewrites": [], "not_rewritten": {}, "ledger_entry": None, "commit": None,
              "checks": None}
    refusals = report["refusals"]
    top = run(root, "rev-parse", "--show-toplevel")
    if top.returncode != 0 or Path(top.stdout.strip()).resolve() != root.resolve():
        refusals.append(refusal("not-a-repository", REFUSAL_HELP["not-a-repository"] + ": " + str(root)))
        return finish(report)
    if run(root, "rev-parse", "--verify", "-q", "HEAD").returncode != 0:
        refusals.append(refusal("no-commits", REFUSAL_HELP["no-commits"]))
        return finish(report)
    kind, _directory, found = resolve_layout(root)
    report["layout"] = {"new": "new", "legacy": "legacy", "half": "half-migrated", "none": "none"}[kind]
    tracked = tracked_files(root)
    dirty = dirty_paths(root)
    if dirty:
        refusals.append(refusal("dirty-tree", REFUSAL_HELP["dirty-tree"] + ": " + ", ".join(dirty[:8])
                                + (" ..." if len(dirty) > 8 else ""), dirty))
    if kind == "half":
        where = " and ".join(p.relative_to(root).as_posix() for p in reversed(found))
        refusals.append(refusal("half-migrated", "SESSION_RUNNER.md is at " + where
                                + ": never guess which is the framework's; remove one", [p.relative_to(root).as_posix() for p in found]))
    if tier == "2" and kind != "new":
        refusals.append(refusal("tier-order", REFUSAL_HELP["tier-order"] + " (run tier 1 first, or --tier all)"))
    moves, left, collisions = plan_moves(root, tier, tracked, kind)
    if collisions:
        refusals.append(refusal("destination-exists", REFUSAL_HELP["destination-exists"] + ": " + ", ".join(collisions), collisions))
    if is_ignore_mode(root):
        refusals.append(refusal("ignore-mode", REFUSAL_HELP["ignore-mode"] + " (.gitignore lists a methodology file): this tool moves files that git tracks"))
    present = bool(moves) or any((root / d).is_file() for _s, d, _x in DISTRIBUTION) \
        or any((root / NEW_LAYOUT[s]).is_file() for s, _d, _x in DISTRIBUTION)
    if present:
        rows, why = read_status(root)
        if rows is None:
            refusals.append(refusal("status-unavailable", REFUSAL_HELP["status-unavailable"] + ": " + why))
        else:
            bad = [f"{f} ({s})" for f, d, s in rows if d == TRACKED and s != "current" and s != "half-migrated"]
            if bad:
                refusals.append(refusal("not-current", "bin/status does not read every TRACKED file current: run bin/sync first (plan 5A.2): "
                                        + ", ".join(bad), [b.split(" (")[0] for b in bad]))
    report["moves"], report["left_in_place"] = moves, left
    rewrites = plan_rewrites(root, moves) if moves else []
    report["rewrites"] = [r.as_report() for r in rewrites]
    report["_rewrites"] = rewrites
    if not refusals and not present:
        report["status"] = "nothing-to-do"
        return report
    if not refusals and not moves:
        report["status"] = "nothing-to-do"
    return finish(report)


def finish(report):
    if report["refusals"]:
        report["status"] = "refused"
        report["moves"] = report["moves"] if report["moves"] else []
    return report


def remove_empty_parents(root, rel):
    """rmdir the directories a move emptied, from the file's old parent up, never the project root."""
    d = Path(root) / rel
    for parent in d.parents:
        if parent == Path(root):
            break
        try:
            parent.rmdir()
        except OSError:
            break


def commit_message(report, moves):
    tracked = [m for m in moves if m["tracked"]]
    plain = [m for m in moves if not m["tracked"]]
    sha = report["canonical"]["sha"] or "an unknown commit"
    modified = " (plus uncommitted changes)" if report["canonical"].get("modified") else ""
    lines = ["chore(methodology): move the methodology files under methodology/ (tier %s, %d files)" % (report["tier"], len(moves)),
             "",
             "Moved by bin/migrate-layout of the KJ5HST/methodology checkout at %s%s (BL-101 P7)." % (sha, modified),
             "%d file(s) with git mv%s." % (len(tracked), (", %d without git (generated files that .gitignore keeps out of the repository)" % len(plain)) if plain else ""),
             "Every tracked move is a rename at 90% similarity or better (git diff -M), so git log --follow reaches the history before the move.",
             "No committed ledger entry and no ledger shard was edited."]
    return "\n".join(lines)


def renames_in_index(project):
    """{(src, dest): score} for the renames git finds between HEAD and the index."""
    out = run(project, "diff", "--cached", "-M", "--name-status", "-z").stdout.split("\0")
    renames, i = {}, 0
    while i < len(out):
        status = out[i]
        if status.startswith("R"):
            renames[(out[i + 1], out[i + 2])] = int(status[1:])
            i += 3
        else:
            i += 2 if status else 1
    return renames


def rollback(root, done_plain, methodology_existed):
    """Give the tree back: the index and every tracked file from HEAD, the files git does not track moved home,
    and the directories the run created removed. The run started from a clean tree, so nothing else is lost."""
    run(root, "reset", "-q", "--hard", "HEAD")
    for src, dest in reversed(done_plain):
        if (root / dest).is_file() and not (root / src).exists():
            os.rename(root / dest, root / src)
    if not methodology_existed:
        for d in sorted((p for p in (root / NEW_DIR).rglob("*") if p.is_dir()), key=lambda p: -len(p.parts)):
            try:
                d.rmdir()
            except OSError:
                pass
        try:
            (root / NEW_DIR).rmdir()
        except OSError:
            pass


def apply_migration(report, trailers):
    """Do the plan: the moves, the edits, ONE commit. Any failure before or at the commit is rolled back."""
    root = Path(report["project"])
    moves, rewrites = report["moves"], report["_rewrites"]
    methodology_existed = (root / NEW_DIR).exists()
    done_plain = []
    try:
        for m in moves:
            (root / m["dest"]).parent.mkdir(parents=True, exist_ok=True)
            if m["tracked"]:
                r = run(root, "mv", m["src"], m["dest"])
                if r.returncode != 0:
                    raise RuntimeError("git mv %s %s failed: %s" % (m["src"], m["dest"], r.stderr.strip()))
            else:
                os.rename(root / m["src"], root / m["dest"])
                done_plain.append((m["src"], m["dest"]))
        for rw in rewrites:
            (root / rw.final).write_text(rw.new, encoding="utf-8")
            r = run(root, "add", "--", rw.final)
            if r.returncode != 0:
                raise RuntimeError("git add %s failed: %s" % (rw.final, r.stderr.strip()))
        for m in moves:
            remove_empty_parents(root, m["src"])
        renames = renames_in_index(root)
        weak = []
        for m in moves:
            if m["tracked"]:
                score = renames.get((m["src"], m["dest"]))
                if score is None or score < 90:
                    weak.append("%s -> %s (%s)" % (m["src"], m["dest"], "not a rename" if score is None else "%d%%" % score))
        if weak:
            raise RuntimeError("a moved file would fall below 90%% similarity, so git log --follow could not reach its history: "
                               + ", ".join(weak))
        parent = run(root, "rev-parse", "HEAD").stdout.strip()
        message = commit_message(report, moves) + (("\n\n" + "\n".join(trailers)) if trailers else "")
        r = subprocess.run(["git", "-C", str(root), "commit", "-q", "-F", "-"], input=message + "\n", capture_output=True, text=True)
        if r.returncode != 0:
            raise RuntimeError("git commit was refused: " + (r.stdout + r.stderr).strip())
    except Exception as e:  # noqa: BLE001 -- every failure rolls back, then is reported
        rollback(root, done_plain, methodology_existed)
        report["status"] = "rolled-back"
        report["commit"] = {"error": str(e)}
        return 3
    report["status"] = "applied"
    report["commit"] = {"sha": run(root, "rev-parse", "HEAD").stdout.strip(), "parent": parent, "message": message,
                        "renames": [{"src": s, "dest": d, "score": sc} for (s, d), sc in sorted(renames.items())
                                    if any(m["src"] == s and m["dest"] == d for m in moves)]}
    return 0


def render_text(report):
    out = ["migrate-layout: %s" % report["project"],
           "canonical: %s @ %s" % (report["canonical"]["path"], (report["canonical"]["sha"] or "unknown")[:12]),
           "layout: %s   tier: %s   mode: %s" % (report["layout"], report["tier"],
                                                 "dry run (nothing written; add --apply to migrate)" if report["mode"] == "dry-run" else "apply")]
    if report["refusals"]:
        out.append("")
        out.append("REFUSED:")
        for r in report["refusals"]:
            out.append("  - [%s] %s" % (r["code"], r["message"]))
    if report["status"] == "nothing-to-do":
        out.append("")
        out.append("nothing to migrate: no methodology file is left to move")
    if report["moves"]:
        out.append("")
        out.append("moves (%d):" % len(report["moves"]))
        for m in report["moves"]:
            out.append("  git mv %s %s%s" % (m["src"], m["dest"], "" if m["tracked"] else "   (not tracked: a plain move)"))
    if report["left_in_place"]:
        out.append("")
        out.append("left in place (%d):" % len(report["left_in_place"]))
        for x in report["left_in_place"]:
            out.append("  %s -- %s" % (x["path"], x["reason"]))
    if report["rewrites"]:
        out.append("")
        out.append("rewrites (%d file(s)):" % len(report["rewrites"]))
        for rw in report["rewrites"]:
            out.append("  %s (%d replacement(s))" % (rw["path"], rw["replacements"]))
            out.extend("    " + line for line in rw["diff"].splitlines())
    if report["status"] == "applied":
        out.append("")
        out.append("APPLIED: one commit, %s" % report["commit"]["sha"][:12])
    if report["status"] == "rolled-back":
        out.append("")
        out.append("ROLLED BACK: %s" % report["commit"]["error"])
        out.append("the project is as it was before the run")
    return "\n".join(out) + "\n"


def main():
    p = argparse.ArgumentParser(description="Move a project's methodology files under methodology/ (a dry run unless --apply).")
    p.add_argument("project", help="the project directory (the top of a git repository)")
    p.add_argument("--apply", action="store_true", help="write the migration as one commit (the default is a dry run)")
    p.add_argument("--tier", choices=("1", "2", "all"), default="all", help="1: the framework's files; 2: the project's state; all (default)")
    p.add_argument("--trailer", action="append", default=[], metavar="TEXT", help="a trailer line for the commit message, e.g. a Co-Authored-By line (repeatable)")
    p.add_argument("--skip-checks", action="store_true", help="do not run the before-and-after checks of an apply")
    p.add_argument("--json", action="store_true", help="print the report as JSON")
    args = p.parse_args()
    project = Path(args.project)
    if not project.is_dir():
        print("error: %s is not a directory" % project, file=sys.stderr)
        return 2
    report = build_report(project, args.tier, args.apply)
    code = 0
    if report["status"] == "refused":
        code = 1
    elif args.apply and report["status"] == "ok":
        code = apply_migration(report, args.trailer)
    report.pop("_rewrites", None)
    print(json.dumps(report, indent=2) if args.json else render_text(report), end="" if not args.json else "\n")
    return code


if __name__ == "__main__":
    sys.exit(main())
